{
  "name": "conjecturehub",
  "private": true,
  "version": "0.1.0",
  "description": "A living index of every mathematical conjecture, and who has proved what.",
  "license": "Apache-2.0",
  "workspaces": [
    "ingest",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "npm run validate --workspace ingest",
    "format": "npm run format --workspace ingest --",
    "seed": "npm run seed --workspace ingest",
    "sweep": "npm run sweep --workspace ingest",
    "build:index": "npm run build:index --workspace ingest",
    "sync:erdos-forum": "npm run sync:erdos-forum --workspace ingest",
    "refresh:notability": "npm run refresh:notability --workspace ingest --",
    "enrich:wikipedia": "npm run enrich:wikipedia --workspace ingest --",
    "file:resolutions": "npm run file:resolutions --workspace ingest --",
    "check:links": "npm run check:links --workspace ingest",
    "selftest": "npm run selftest --workspace ingest",
    "solve:sandbox": "npm run solve:sandbox --workspace ingest --",
    "dev": "npm run dev --workspace web",
    "build": "npm run build:index && npm run build --workspace web"
  }
}
