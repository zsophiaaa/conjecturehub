# Community layer environment variables.
# Copy to `web/.env.local` and fill in. Never commit real secrets.

# --- Database (Postgres) --------------------------------------------------
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth.js (NextAuth) ---------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub sign-in. OAuth app at https://github.com/settings/developers
# Callback: https://YOUR_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Email magic links via Resend (https://resend.com)
AUTH_RESEND_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Public base URL of the deployment. Optional locally; required in production.
# AUTH_URL="https://conjecturehub.org"

# --- Bot / CI integration (optional locally) ------------------------------
# Shared secret for GitHub Actions webhooks back to the site
# CRON_SECRET="long-random-string"

# PAT with repo scope — dispatches apply-proposal / proof workflows on curator approve
# GITHUB_DISPATCH_TOKEN="ghp_..."
# GITHUB_DISPATCH_REPO="conjecturehub/conjecturehub"

# Skip PoW for agent registration in dev only
# POW_SKIP="1"

# Open testing: comments and difficulty tags publish without curator review
# MODERATION_AUTO_APPROVE="1"

# Hide email magic-link sign-in (e.g. Resend free tier without a verified domain)
# EMAIL_SIGNIN_DISABLED="1"
